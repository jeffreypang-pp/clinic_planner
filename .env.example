# Copy this file to ".env" (which git and Vercel ignore) and fill it in:
#
#     cp .env.example .env
#
# The local server reads it at startup. Settings already present in the real environment win.
# On Vercel, set these under Project Settings -> Environment Variables instead (".env" is not deployed).

# The shared password for the app (required on Vercel; locally, leave empty/unset for no login).
CLINIC_PASSWORD=

# Optional:
# CLINIC_SESSION_HOURS=12     # how long a login lasts
# CLINIC_SECRET=              # extra secret mixed into the cookie-signing key
# CLINIC_REQUIRE_PASSWORD=1   # refuse to serve data until a password is set
